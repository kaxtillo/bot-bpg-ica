completions/
logs/
delivery-queue/
canvas/
browser/
media/
cron/
extensions/
agents/
node_modules/

# Cache de Python
__pycache__/
*.pyc
.cache/
*.egg-info/
venv/

# Respaldos y temporales
*.tar.gz
*.bak
tmp/
/tmp/

# Archivos de script generados
generar_*.py
venv/
*.pyc
__pycache__/
.cache/
inbound/
